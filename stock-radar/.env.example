# 키움 REST API - 실전 키는 채팅/깃허브에 올리지 마세요.
KIWOOM_MODE=real
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
# 선택: 직접 발급 토큰을 잠시 쓸 때만. 기본은 App Key/Secret으로 자동 발급.
# KIWOOM_ACCESS_TOKEN=
# KIWOOM_BASE_URL=https://api.kiwoom.com
# KIWOOM_WS_URL=wss://api.kiwoom.com:10000
KIWOOM_MIN_REQUEST_GAP_MS=220

RADAR_ALERT_SCORE=70
RADAR_REALTIME_ALERT_SCORE=65
RADAR_TOP_N=40
RADAR_WATCHLIST_REFRESH_MS=30000
RADAR_ALERT_COOLDOWN_MS=600000

# 선택: 휴대폰/앱 알림 웹훅
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_BEARER=
