# 스캐너 설정
RADAR_MARKET=J
RADAR_ALERT_SCORE=70
RADAR_TOP_N=12
RADAR_ENRICH_N=8

# 선택: 알림 수신 웹훅. 미설정이면 API 응답/로그만 생성
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_BEARER=
