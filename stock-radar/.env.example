# 한국투자증권 Open API - 절대 GitHub에 실제 값을 커밋하지 마세요.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# 선택: 실전 계정의 발급 토큰을 외부에서 안전하게 관리하는 경우
